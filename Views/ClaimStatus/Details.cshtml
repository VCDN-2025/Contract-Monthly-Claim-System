@model CMCS.Models.ClaimModel
@using System.Globalization 

@{
    ViewData["Title"] = "Claim Details: " + Model.ClaimId;
}

<h1 class="mb-4">Claim Details: @Model.ClaimId</h1>
<hr />

<dl class="row">
    <dt class="col-sm-4">Submission Date:</dt>
    <dd class="col-sm-8">@Model.SubmissionDate.ToString("yyyy/MM/dd")</dd>

    <dt class="col-sm-4">Total Amount:</dt>
    <dd class="col-sm-8 h4">
        R@(Model.ClaimAmount.ToString("F2"))
    </dd>

    <dt class="col-sm-4">Status:</dt>
    <dd class="col-sm-8">@Model.Status</dd>

    <dt class="col-sm-4">Hours Claimed:</dt>
    <dd class="col-sm-8">@Model.HoursWorked hours</dd>

    <dt class="col-sm-4">Contract Rate:</dt>
    <dd class="col-sm-8">
        R@(Model.HourlyRate.ToString("F2"))
    </dd>

    <dt class="col-sm-4">Document ID:</dt>
    <dd class="col-sm-8">@Model.DocumentId</dd>

                    @if (!string.IsNullOrEmpty(Model.AdditionalNotes))
                    {
                        <dt class="col-sm-12 mt-3">Additional Notes:</dt>
                        <dd class="col-sm-12 alert alert-secondary">@Model.AdditionalNotes</dd>
                    }
              

    <div class="col-md-5">
        <div class="card shadow-sm mt-3 mt-md-0">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Approval Timeline</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <strong>PC Verification:</strong> @(Model.PcActionDate?.ToShortDateString() ?? "Pending")
                    </li>
                    <li class="list-group-item">
                        <strong>AM Final Approval:</strong> @(Model.AmActionDate?.ToShortDateString() ?? "Pending")
                    </li>
                    @if (Model.Status == ClaimStatus.Approved || Model.Status.ToString().Contains("Rejected"))
                    {
                        <li class="list-group-item bg-light">
                            <strong>Finalized:</strong> @Model.Status
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Index" class="btn btn-secondary">Back to Claims List</a>
</div>