@{
    ViewData["Title"] = "HR Management Dashboard";
}

<div class="container mt-4">
    <h1 class="mb-4">HR Management Dashboard</h1>
    <hr />

    <div class="row">

        <div class="col-md-6 mb-4">
            <div class="card text-center bg-light shadow-lg border-primary">
                <div class="card-body">
                    <h5 class="card-title text-primary">Lecturer Contracts & Information</h5>
                    <p class="card-text">Access the full CRUD system to view, add, and update lecturer profiles and contract details.</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="LecturerInformation" asp-action="Index" class="btn btn-primary btn-lg stretched-link">Manage Lecturer Contracts</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card text-center shadow-lg border-warning">
                <div class="card-body">
                    <h5 class="card-title text-warning">Lecturer Claim Rate Setup</h5>
                    <p class="card-text">Set the official contract hourly rate used for claim automation.</p>
                </div>
                <div class="card-footer bg-transparent border-0">
                    <a asp-controller="HR" asp-action="ManageRates" class="btn btn-warning btn-lg stretched-link">Manage Rates</a>
                </div>
            </div>
        </div>
        <div class="card h-100 shadow-lg border-success">
            <div class="card-body text-center">
                <h5 class="card-title text-success">User & Role Management</h5>
                <p class="card-text">Create new user accounts and assign roles (Lecturer, PC, AM).</p>
                <a asp-action="CreateUser" class="btn btn-success btn-lg">Create New User</a>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-12">
            <div class="alert alert-info">
                <strong>System Note:</strong> Lecturer profile updates (name, rate) made here will immediately affect any new claims submitted.
            </div>
        </div>
    </div>
</div>