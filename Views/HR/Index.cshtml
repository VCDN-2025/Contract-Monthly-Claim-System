@model IEnumerable<CMCS.Models.LecturerModel>
@{
    ViewData["Title"] = "HR Management Dashboard";
}

<h1 class="mb-4">HR Management Dashboard</h1>
<p class="lead">System administration, user account management, and claims reporting.</p>
<hr />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="container mt-5">
    <div class="row">
        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-lg border-primary">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">User Account Creation</h5>
                </div>
                <div class="card-body text-center">
                    <p class="card-text">Create new user accounts and assign roles (Lecturer, PC, AM).</p>
                </div>
                <div class="card-footer bg-transparent text-center">
                    <a asp-controller="HR" asp-action="CreateUser" class="btn btn-primary btn-lg stretched-link">Create New User</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-lg border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">Lecturer Profiles & Rates</h5>
                </div>
                <div class="card-body text-center">
                    <p class="card-text">Access the full CRUD system to link accounts, set the official claim rate, and update contract details.</p>
                </div>
                <div class="card-footer bg-transparent text-center">
                    <a asp-controller="LecturerInformation" asp-action="Index" class="btn btn-success btn-lg stretched-link">Manage Profiles & Rates</a>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-6 mb-4">
            <div class="card h-100 shadow-lg border-secondary">
                <div class="card-header bg-dark text-white">
                    <h5 class="card-title mb-0">Claims Report Generator</h5>
                </div>
                <div class="card-body text-center">
                    <p class="card-text">Generate claims reports with multiple filters (status, amount, date) for payment processing.</p>
                </div>
                <div class="card-footer bg-transparent text-center">
                    <a asp-controller="HR" asp-action="Reports" class="btn btn-dark btn-lg stretched-link">Generate Reports</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
    </div>
</div>