@model CMCS.Models.ReportFilterViewModel
@using CMCS.Models
@using System.Globalization

@{
    ViewData["Title"] = "Claims Report Generator";
    var statuses = Enum.GetValues(typeof(ClaimStatus)).Cast<ClaimStatus>();
}

<h1 class="mb-4">Claims Report Generator</h1>
<p class="lead">Use the filters below to generate reports based on claim status, amount, and submission date.</p>
<hr />

<div class="card shadow-sm mb-4">
    <div class="card-header bg-dark text-white">
        <h5>Report Filters</h5>
    </div>
    <div class="card-body">
        <form asp-action="Reports" method="post">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Status" class="form-label">Filter by Status</label>
                    <select asp-for="Status" class="form-control" asp-items="@(new SelectList(statuses))">
                        <option value="">-- All Statuses --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="MinAmount" class="form-label">Min Amount (R)</label>
                    <input asp-for="MinAmount" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-3">
                    <label asp-for="MaxAmount" class="form-label">Max Amount (R)</label>
                    <input asp-for="MaxAmount" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-3">
                    <label asp-for="ClaimId" class="form-label">Filter by Claim ID</label>
                    <input asp-for="ClaimId" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label asp-for="StartDate" class="form-label">Start Date</label>
                    <input asp-for="StartDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="EndDate" class="form-label">End Date</label>
                    <input asp-for="EndDate" class="form-control" type="date" />
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <button type="submit" class="btn btn-primary btn-lg">Generate Report</button>
            </div>
        </form>
    </div>
</div>


<div class="card shadow-sm mt-5">
    <div class="card-header bg-success text-white">
        <h5>Report Results (@Model.FilteredClaims.Count)</h5>
    </div>
    <div class="card-body">
        @if (!Model.FilteredClaims.Any())
        {
            <p class="text-center text-muted">No claims found matching the current filter criteria.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Claim ID</th>
                            <th>Status</th>
                            <th>Amount</th>
                            <th>Submission Date</th>
                            <th>PC Action</th>
                            <th>AM Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.FilteredClaims)
                        {
                            <tr>
                                <td>@claim.ClaimId</td>
                                <td>
                                    <span class="badge bg-secondary">@claim.Status</span>
                                </td>
                                <td>@claim.ClaimAmount.ToString("C", new CultureInfo("en-ZA"))</td>
                                <td>@claim.SubmissionDate.ToShortDateString()</td>
                                <td>@(claim.PcActionDate?.ToShortDateString() ?? "N/A")</td>
                                <td>@(claim.AmActionDate?.ToShortDateString() ?? "N/A")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}