@model IEnumerable<CMCS.Models.ClaimModel>
@using CMCS.Models

@{
    ViewData["Title"] = "Academic Manager Dashboard";
}

<h1 class="mb-4">Claims for Academic Manager Approval</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-lg">
    <div class="card-header bg-danger text-white">
        <h5>Awaiting Final Approval (@Model.Count())</h5>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-center text-muted">No claims currently require final approval.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="bg-primary text-white">
                        <tr>
                            <th scope="col">Claim ID</th>
                            <th scope="col">Hours/Rate</th>
                            <th scope="col">Amount</th>
                            <th scope="col">PC Action Date</th>
                            <th scope="col">Document</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model)
                        {
                            <tr>
                                <td>**@claim.ClaimId**</td>
                                <td>@claim.HoursWorked HRS@(claim.HourlyRate.ToString("C0")) / HR</td>
                                <td>R@(claim.ClaimAmount.ToString("N2"))</td>
                                <td>@claim.PcActionDate?.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <a asp-controller="ProgrammeCoOrdinator" asp-action="DownloadDocument" asp-route-claimId="@claim.ClaimId" class="btn btn-sm btn-secondary">
                                        View/Download
                                    </a>
                                </td>
                                <td>
                                    <form asp-action="Approve" asp-route-id="@claim.ClaimId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success" 
                                                onclick="return confirm('Are you sure you want to APPROVE Claim @claim.ClaimId for payment?');">Approve</button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@claim.ClaimId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-danger" 
                                                onclick="return confirm('Are you sure you want to REJECT Claim @claim.ClaimId?');">Reject</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>